# ============================================================
# ShivSamarth Motor Driving School - Production Configuration
# ============================================================

# HTTP Port (Defaults to 5000 if omitted, assigned by Render/Railway/Fly.io automatically)
PORT=5000

# Environment Mode
NODE_ENV=production

# JWT Signing Secret Key (Generate a random 64-character secret for production)
JWT_SECRET=shivsamarth_jwt_secret_key_2026_super_secure_production

# SQLite Database File Path (Optionally mount to persistent volume, e.g., /data/driving_school.sqlite)
# DB_PATH=./server/driving_school.sqlite

# ==============================================================
# Firebase Cloud Configuration (Optional Server / Cloud Sync)
# ==============================================================
# FIREBASE_PROJECT_ID=your-project-id
# FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
# FIREBASE_SERVICE_ACCOUNT_KEY='{"type": "service_account", ...}'

