{
  "name": "driving-school-app",
  "version": "1.0.0",
  "description": "Custom Driving School Management Web Application",
  "main": "server/index.js",
  "scripts": {
    "postinstall": "npm --prefix client install",
    "server": "node server/index.js",
    "client": "npm --prefix client run dev",
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run server\" \"npm run client\"",
    "build": "npm --prefix client install && npm --prefix client run build",
    "start": "node server/index.js"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "keywords": [
    "driving-school",
    "management-system"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "firebase": "^13.3.0",
    "firebase-admin": "^14.5.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
